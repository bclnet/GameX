<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GodotDisabledSourceGenerators>ScriptPathAttribute;GodotPluginsInitializer</GodotDisabledSourceGenerators>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OpenX\OpenX.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Godot.SourceGenerators" Version="4.8.0-beta.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>$(ProgramFiles)\Godot\Godot_v4.8\GodotSharp\Api\Debug\GodotSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
